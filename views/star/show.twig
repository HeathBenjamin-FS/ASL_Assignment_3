{% extends 'layouts/base.twig'%}

{% block pageName %}{{ star.name }}{% endblock %}

{% block main %}
    <h1>{{ star.name }}</h1>

    <p><strong>ID:</strong> {{ star.id }}</p>
    <p><strong>Size:</strong> {{ star.size }}</p>
    <p><strong>Description:</strong> {{ star.description }}</p>

    <p>
        <a href="/stars/{{ star.id }}/edit">Edit this Star</a> |
        <a href="/stars/{{ star.id }}/delete">Delete this Star</a>
    </p>

     <div>
        <img src="/uploads/stars/{{star.id}}.png" alt="{{star.name}}" class="resourceImg" onerror="this.style.display='none';">
    </div>


    <p><a href="/stars">Back to all Stars</a></p>
    
{% endblock %}