<div>
    <label for="name">Galaxy Name:</label>
    <input type="text" id="name" name="name" value="{{galaxy.name}}" required>
</div> 
<div>
    <label for="size">Size:</label>
    <input type="number" id="size" name="size" value="{{galaxy.size}}">
</div>
<div>
    <label for="desciption">Description</label>
    <textarea id="description" name="description">{{galaxy.description}}</textarea>
</div>
 <div>
    <label for="image">Upload Image</label>
    <input type="file" id="image" name="image" accept="image/*">
</div> 

<button type="submit">Save Galaxy</button>